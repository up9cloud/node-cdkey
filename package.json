{
  "name": "cdkey",
  "version": "2.0.3",
  "description": "Generate random strings by template.",
  "main": "src/index.js",
  "files": [
    "dist/*",
    "lib/*",
    "src/*",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src test",
    "clean": "rm -f dist/* lib/*",
    "build": "npm run clean && webpack --config build/webpack.config.js",
